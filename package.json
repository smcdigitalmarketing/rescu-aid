    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
